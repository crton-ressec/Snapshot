{
  "expo": {
    "name": "Snapshot",
    "slug": "snapshot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C853"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapshot.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Snapshot needs camera access to take photos and videos like Snapchat.",
        "NSPhotoLibraryUsageDescription": "Snapshot needs photo library access to share images.",
        "NSMicrophoneUsageDescription": "Snapshot needs microphone access for videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00C853"
      },
      "package": "com.snapshot.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Snapshot to access your camera",
          "microphonePermission": "Allow Snapshot to access your microphone",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "snapshot",
    "experiments": {
      "typedRoutes": true
    }
  }
}
